{
  "name": "react-native-contains",
  "version": "1.1.0",
  "description": "Universal element contains for react, react-native, and react-native web",
  "keywords": [
    "react-native",
    "react-native-web",
    "react",
    "native",
    "web",
    "dom",
    "contains",
    "universal",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmalakoff/react-native-contains.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff@gmail.com> (https://github.com/kmalakoff)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json",
    "./umd": "./dist/umd/react-native-contains.cjs"
  },
  "main": "dist/cjs/index.js",
  "source": "src/index.ts",
  "types": "dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsds build",
    "docs": "tsds docs",
    "format": "tsds format",
    "prepublishOnly": "tsds validate",
    "test": "npm run test:types && node test/lib/browser.mjs && tsds test:node --no-timeouts --exclude test/unit/dom.test.tsx --exclude test/exports/umd-browser.test.ts",
    "test:browser:checkpoints": "node test/lib/browser-checkpoints.mjs",
    "test:engines": "npm run build && node test/engines/run.ts",
    "test:types": "npm run build && node test/types/run.mjs",
    "version": "tsds version"
  },
  "devDependencies": {
    "@types/mocha": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@web/dev-server-import-maps": "^0.3.0",
    "assert": "^1.5.0",
    "esbuild": "^0.28.2",
    "fs-remove-compat": "*",
    "node-version-use": "*",
    "react": "*",
    "react-dom": "*",
    "react-native": "*",
    "tar": "^7.4.3",
    "ts-dev-stack": "*",
    "tsds-config": "*",
    "tsds-web-test-runner": "*"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "engines": {
    "node": ">=16"
  },
  "allowScripts": {
    "esbuild": true
  },
  "tsds": {
    "targets": [
      "cjs",
      "esm",
      "umd"
    ],
    "globals": {
      "react": "React",
      "react-native": "ReactNative"
    }
  }
}
