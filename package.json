{
  "name": "react-native-contains",
  "version": "1.0.15",
  "description": "Universal element contains for react, react-native, and react-native web",
  "keywords": [
    "react-native",
    "react-native-web",
    "react",
    "native",
    "web",
    "dom",
    "contains",
    "universal",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmalakoff/react-native-contains.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff@gmail.com> (https://github.com/kmalakoff)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json",
    "./umd": "./dist/umd/react-native-contains.cjs"
  },
  "main": "dist/cjs/index.js",
  "source": "src/index.ts",
  "types": "dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsds build",
    "docs": "tsds docs",
    "format": "tsds format",
    "prepublishOnly": "tsds validate",
    "test": "tsds test:browser --config wtr.config.mjs && tsds test:node --no-timeouts",
    "test:engines": "tsds test:browser --config wtr.config.mjs && nvu engines tsds test:node --no-timeouts",
    "version": "tsds version"
  },
  "devDependencies": {
    "@types/mocha": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@web/dev-server-import-maps": "^0.3.0",
    "jsdom": "^30.0.1",
    "node-version-use": "*",
    "react": "*",
    "react-dom": "*",
    "react-native": "*",
    "react-test-renderer": "*",
    "ts-dev-stack": "*",
    "tsds-config": "*",
    "tsds-web-test-runner": "*"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "engines": {
    "node": ">=16"
  },
  "allowScripts": {
    "esbuild": true,
    "node-filename-to-dist-paths": true,
    "node-semvers": true,
    "node-version-use": true,
    "thread-sleep-compat": true
  },
  "tsds": {
    "targets": [
      "cjs",
      "esm",
      "umd"
    ],
    "globals": {
      "react": "React",
      "react-native": "ReactNative"
    }
  }
}
